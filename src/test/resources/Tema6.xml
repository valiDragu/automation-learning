<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Tema 6">
    <test name="Ex 3 and 4">
        <groups>
            <run>
                <include name="ex3"/>
                <include name="ex4"/>
            </run>
        </groups>

        <classes>
            <class name="Tema6.Tema6"/>
        </classes>
    </test>

    <test name="Functional">
        <groups>
            <run>
                <include name="functional"/>
                <exclude name="ex4"/>
            </run>
        </groups>

        <classes>
            <class name="Tema6.Tema6"/>
        </classes>
    </test>

    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="Tema6.Tema6"/>
        </classes>
    </test>

    <test name="Sanity">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>

        <classes>
            <class name="Tema6.Tema6"/>
        </classes>
    </test>

    <test name="All">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="sanity"/>
                <include name="functional"/>
            </run>
        </groups>

        <classes>
            <class name="Tema6.Tema6"/>
        </classes>
    </test>
</suite>